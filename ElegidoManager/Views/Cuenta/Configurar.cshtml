@model NuevoUsuarioViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Configuración inicial";
}
<h2 class="auth-titulo">Configuración inicial</h2>
<p class="auth-texto">Aún no hay usuarios registrados. Crea la cuenta del administrador principal del grupo.</p>

<form asp-action="Configurar" method="post" class="form-em" novalidate>
    <div asp-validation-summary="ModelOnly" class="alerta alerta-error"></div>
    <div class="mb-3">
        <label asp-for="NombreCompleto" class="form-label"></label>
        <input asp-for="NombreCompleto" class="form-control" autofocus />
        <span asp-validation-for="NombreCompleto" class="text-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Usuario" class="form-label"></label>
        <input asp-for="Usuario" class="form-control" autocomplete="username" />
        <span asp-validation-for="Usuario" class="text-error"></span>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <label asp-for="Contrasena" class="form-label"></label>
            <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Contrasena" class="text-error"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="ConfirmarContrasena" class="form-label"></label>
            <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarContrasena" class="text-error"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-oro w-100 btn-lg">Crear administrador</button>
</form>
