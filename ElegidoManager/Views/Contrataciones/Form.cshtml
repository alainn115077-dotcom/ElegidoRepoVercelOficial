@model ContratacionFormViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var precioPorHora = decimal.TryParse(Config["Tarifas:PrecioPorHora"], NumberStyles.Number, CultureInfo.InvariantCulture, out var pph) ? pph : 3500m;
    var precioTuba = decimal.TryParse(Config["Tarifas:PrecioPorHoraTuba"], NumberStyles.Number, CultureInfo.InvariantCulture, out var ppt) ? ppt : 4300m;
    var anticipoSugerido = decimal.TryParse(Config["Tarifas:AnticipoSugerido"], NumberStyles.Number, CultureInfo.InvariantCulture, out var ans) ? ans : 500m;
    var mx = new CultureInfo("es-MX");
    ViewData["Title"] = Model.EsEdicion ? "Editar contratación" : "Nueva contratación";
    ViewData["Subtitulo"] = Model.EsEdicion ? "Los cambios se guardan directamente en la base de datos" : "Cliente, fecha, horario y pago en un solo paso";
    var meses = new[] { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
    var hora = Model.HoraInicio.HasValue ? Model.HoraInicio.Value.ToString(@"hh\:mm") : "";
    int? hora12 = null; var minuto = 0; var esPm = true;
    if (Model.HoraInicio.HasValue)
    {
        var h24 = Model.HoraInicio.Value.Hours;
        esPm = h24 >= 12;
        hora12 = h24 % 12 == 0 ? 12 : h24 % 12;
        minuto = Model.HoraInicio.Value.Minutes;
    }
    var minutos = new List<int> { 0, 15, 30, 45 };
    if (!minutos.Contains(minuto)) { minutos.Add(minuto); minutos.Sort(); }
}
<form asp-action="@(Model.EsEdicion ? "Editar" : "Crear")" asp-route-id="@(Model.EsEdicion ? Model.Id.ToString() : null)" method="post" class="form-em" id="formContratacion" novalidate
      data-precio-hora="@precioPorHora.ToString(CultureInfo.InvariantCulture)" data-precio-tuba="@precioTuba.ToString(CultureInfo.InvariantCulture)" data-anticipo="@anticipoSugerido.ToString(CultureInfo.InvariantCulture)" data-edicion="@(Model.EsEdicion ? "true" : "false")">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="NuevoCliente" id="NuevoCliente" />
    <input type="hidden" asp-for="DiaOriginal" id="DiaOriginal" />
    <input type="hidden" asp-for="MesOriginal" id="MesOriginal" />
    <input type="hidden" asp-for="AnioOriginal" id="AnioOriginal" />
    <input type="hidden" name="HorarioPendiente" id="HorarioPendiente" value="@(Model.HorarioPendiente ? "true" : "false")" />
    <input type="hidden" name="LugarPendiente" id="LugarPendiente" value="@(Model.LugarPendiente ? "true" : "false")" />

    <div asp-validation-summary="All" class="alerta alerta-error mb-4"></div>

    <div class="row g-4">
        <div class="col-xl-8 d-flex flex-column gap-4">

            <!-- 1. CLIENTE -->
            <section class="tarjeta aparecer">
                @if (Model.EsEdicion)
                {
                    <div class="tarjeta-cabecera"><h2><span class="paso">1</span> Cliente</h2></div>
                    <input type="hidden" asp-for="ClienteId" />
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="ClienteNombre" class="form-label"></label>
                            <input asp-for="ClienteNombre" class="form-control" />
                            <span asp-validation-for="ClienteNombre" class="text-error"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="ClienteTelefono" class="form-label"></label>
                            <input asp-for="ClienteTelefono" class="form-control" inputmode="tel" data-formato-telefono maxlength="12" />
                            <span asp-validation-for="ClienteTelefono" class="text-error"></span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tarjeta-cabecera">
                        <h2><span class="paso">1</span> Cliente</h2>
                        <div class="segmentado" role="group">
                            <button type="button" class="seg-btn @(!Model.NuevoCliente ? "activo" : "")" data-modo-cliente="existente" disabled="@(Model.Clientes.Count == 0)">Cliente registrado</button>
                            <button type="button" class="seg-btn @(Model.NuevoCliente ? "activo" : "")" data-modo-cliente="nuevo">Cliente nuevo</button>
                        </div>
                    </div>
                    <div id="bloqueExistente" class="@(Model.NuevoCliente ? "d-none" : "")">
                        <label asp-for="ClienteId" class="form-label"></label>
                        <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select">
                            <option value="">— Selecciona un cliente —</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="text-error"></span>
                    </div>
                    <div id="bloqueNuevo" class="row g-3 @(Model.NuevoCliente ? "" : "d-none")">
                        <div class="col-md-7">
                            <label asp-for="ClienteNombre" class="form-label"></label>
                            <input asp-for="ClienteNombre" class="form-control" />
                            <span asp-validation-for="ClienteNombre" class="text-error"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="ClienteTelefono" class="form-label"></label>
                            <input asp-for="ClienteTelefono" class="form-control" inputmode="tel" placeholder="899 123 4567" data-formato-telefono maxlength="12" />
                            <span asp-validation-for="ClienteTelefono" class="text-error"></span>
                        </div>
                        <p class="text-secundario small mb-0">Si el teléfono ya existe, se usará el cliente registrado para no duplicar información.</p>
                    </div>
                }
            </section>

            <!-- 2. FECHA, HORARIO Y LUGAR -->
            <section class="tarjeta aparecer">
                <div class="tarjeta-cabecera"><h2><span class="paso">2</span> Fecha, horario y lugar</h2></div>
                <div class="row g-3">
                    <div class="col-5 col-md-2">
                        <label asp-for="Dia" class="form-label"></label>
                        <select asp-for="Dia" class="form-select" id="Dia">
                            <option value="">—</option>
                            @for (var d = 1; d <= 31; d++)
                            {
                                <option value="@d" selected="@(Model.Dia == d)">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-7 col-md-4">
                        <label asp-for="Mes" class="form-label"></label>
                        <select asp-for="Mes" class="form-select" id="Mes">
                            <option value="">—</option>
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(Model.Mes == m)">@meses[m - 1]</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-pendiente @(Model.HorarioPendiente ? "activo" : "")" id="btnHorarioPendiente">
                            <i class="bi bi-hourglass-split"></i> Horario pendiente
                        </button>
                        <small class="text-secundario ms-2">Úsalo si el cliente todavía no te confirma la hora.</small>
                    </div>
                    <div class="col-12 col-md-6 bloque-horario">
                        <label class="form-label">Hora de inicio</label>
                        <input type="hidden" name="HoraInicio" id="HoraInicio" value="@hora" />
                        <div class="reloj12">
                            <select class="form-select" id="selHora" aria-label="Hora">
                                <option value="">Hora</option>
                                @for (var h = 1; h <= 12; h++)
                                {
                                    <option value="@h" selected="@(hora12 == h)">@h</option>
                                }
                            </select>
                            <span class="reloj-dos">:</span>
                            <select class="form-select" id="selMinuto" aria-label="Minutos">
                                @foreach (var m in minutos)
                                {
                                    <option value="@m" selected="@(minuto == m)">@m.ToString("00")</option>
                                }
                            </select>
                            <div class="segmentado ampm">
                                <button type="button" class="seg-btn @(!esPm ? "activo" : "")" data-ampm="am">a. m.</button>
                                <button type="button" class="seg-btn @(esPm ? "activo" : "")" data-ampm="pm">p. m.</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 bloque-horario">
                        <label asp-for="DuracionHoras" class="form-label"></label>
                        <input asp-for="DuracionHoras" type="number" step="0.5" min="0.5" max="12" class="form-control" id="DuracionHoras" placeholder="Ej. 2" value="@(Model.DuracionHoras?.ToString("0.##", CultureInfo.InvariantCulture))" />
                    </div>
                    <div class="col-12 bloque-horario">
                        <div class="chips-duracion">
                            <span class="text-secundario small">Duración rápida:</span>
                            @foreach (var h in new[] { 1, 2, 3, 4 })
                            {
                                <button type="button" class="chip" data-horas="@h">@h h</button>
                            }
                            <button type="button" class="chip chip-tuba" id="btnTuba" aria-pressed="false" title="Con tuba: @precioTuba.ToString("C0", mx) por hora">
                                <i class="bi bi-music-note-beamed"></i> Tuba
                            </button>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="resumen-horario" id="resumenHorario">
                            <i class="bi bi-calendar-event"></i>
                            <span id="textoHorario">Elige el día, el mes, la hora de inicio y la duración.</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div id="disponibilidad" class="disponibilidad d-none" data-url="@Url.Action("Disponibilidad", "Agenda")" data-excluir="@(Model.EsEdicion ? Model.Id.ToString() : "")"></div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-1">
                            <label asp-for="Direccion" class="form-label mb-0"></label>
                            <button type="button" class="btn btn-pendiente btn-sm @(Model.LugarPendiente ? "activo" : "")" id="btnLugarPendiente">
                                <i class="bi bi-geo-alt"></i> Lugar pendiente
                            </button>
                        </div>
                        <input asp-for="Direccion" class="form-control" id="Direccion" placeholder="Ej. Palapa El BOP  ·  Calle Arteaga 1545" autocomplete="off" />
                        <span asp-validation-for="Direccion" class="text-error"></span>
                        <small class="text-secundario d-block mt-1">No necesitas poner la ciudad: si no la escribes, se busca en Reynosa automáticamente.</small>
                    </div>
                    <div class="col-12">
                        <div class="mapa-previa d-none" id="mapaPrevia" data-ciudad="@Mapas.CiudadBase">
                            <div class="mapa-cabecera">
                                <span><i class="bi bi-geo-alt"></i> <span id="mapaTexto"></span></span>
                                <a id="mapaAbrir" href="#" target="_blank" rel="noopener" class="enlace-oro small">Abrir en Google Maps <i class="bi bi-box-arrow-up-right"></i></a>
                            </div>
                            <iframe id="mapaFrame" title="Vista previa del mapa" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- 3. PAGO -->
        <div class="col-xl-4">
            <section class="tarjeta tarjeta-fija aparecer">
                <div class="tarjeta-cabecera"><h2><span class="paso">3</span> Pago</h2></div>
                <div class="mb-3">
                    <label asp-for="PrecioAcordado" class="form-label"></label>
                    <div class="input-icono"><i class="bi bi-currency-dollar"></i>
                        <input asp-for="PrecioAcordado" type="number" step="0.01" min="0" class="form-control" id="PrecioAcordado" list="sugPrecio" value="@(Model.PrecioAcordado?.ToString(CultureInfo.InvariantCulture))" />
                    </div>
                    <datalist id="sugPrecio"><option id="sugPrecio1" value="@precioPorHora.ToString("0", CultureInfo.InvariantCulture)"></option><option id="sugPrecio2" value="@((precioPorHora * 2).ToString("0", CultureInfo.InvariantCulture))"></option></datalist>
                    <div class="chips-duracion mt-2">
                        <button type="button" class="chip" id="chipPrecio1" data-llenar="PrecioAcordado" data-valor="@precioPorHora.ToString("0", CultureInfo.InvariantCulture)">@precioPorHora.ToString("C0", mx)</button>
                        <button type="button" class="chip" id="chipPrecio2" data-llenar="PrecioAcordado" data-valor="@((precioPorHora * 2).ToString("0", CultureInfo.InvariantCulture))">@((precioPorHora * 2).ToString("C0", mx)) · 2 h</button>
                    </div>
                    <span asp-validation-for="PrecioAcordado" class="text-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Anticipo" class="form-label"></label>
                    <div class="input-icono"><i class="bi bi-currency-dollar"></i>
                        <input asp-for="Anticipo" type="number" step="0.01" min="0" class="form-control" id="Anticipo" list="sugAnticipo" value="@(Model.Anticipo?.ToString(CultureInfo.InvariantCulture))" />
                    </div>
                    <datalist id="sugAnticipo"><option value="500"></option></datalist>
                    <div class="chips-duracion mt-2"><button type="button" class="chip" data-llenar="Anticipo" data-valor="500">$500</button></div>
                    <span asp-validation-for="Anticipo" class="text-error"></span>
                </div>
                <input type="hidden" id="OtrosPagos" value="@Model.OtrosPagos.ToString(CultureInfo.InvariantCulture)" />
                @if (Model.OtrosPagos > 0)
                {
                    <p class="text-secundario small">Además ya se registraron otros pagos por @Model.OtrosPagos.ToString("C", mx).</p>
                }
                <div class="resumen-pago">
                    <div><span>Precio</span><strong id="resPrecio">$0.00</strong></div>
                    <div><span>@(Model.OtrosPagos > 0 ? "Pagado" : "Anticipo")</span><strong id="resAnticipo">$0.00</strong></div>
                    <div class="total"><span>Saldo pendiente</span><strong id="resSaldo">$0.00</strong></div>
                </div>
                <div class="mt-3">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-oro btn-lg"><i class="bi bi-check2-circle"></i> @(Model.EsEdicion ? "Guardar cambios" : "Registrar contratación")</button>
                    <a asp-action="@(Model.EsEdicion ? "Detalle" : "Index")" asp-route-id="@(Model.EsEdicion ? Model.Id.ToString() : null)" class="btn btn-ghost">Cancelar</a>
                </div>
            </section>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/contratacion-form.js" asp-append-version="true"></script>
}
