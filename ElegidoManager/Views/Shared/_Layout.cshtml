@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Activo(params string[] controladores) => controladores.Contains(ctrl) ? "active" : "";
    var nombreUsuario = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "";
    var iniciales = string.Concat(nombreUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
    var esAdmin = User.IsInRole(Catalogos.RolAdministrador);
    var soloVer = User.IsInRole(Catalogos.RolIntegrante);
    var esColaborador = User.IsInRole(Catalogos.RolColaborador);
    var hoyTexto = DateTime.Today.ToString("dddd d 'de' MMMM", new CultureInfo("es-MX"));
    hoyTexto = char.ToUpper(hoyTexto[0]) + hoyTexto.Substring(1);
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Elegido" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/img/icono-180.png" />
    <meta name="theme-color" content="#0a0a0b" />
    <title>@ViewData["Title"] · ELEGIDO MANAGER</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Estilos", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.svg" alt="" class="brand-logo" />
                <span class="brand-text">
                    <span class="brand-name">ELEGIDO</span>
                    <span class="brand-sub">MANAGER</span>
                </span>
            </a>

            <nav class="nav-lateral">
                <span class="nav-grupo">General</span>
                <a class="nav-item-em @Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Inicio</span></a>
                <a class="nav-item-em @Activo("Agenda")" asp-controller="Agenda" asp-action="Index"><i class="bi bi-calendar3"></i><span>Agenda</span></a>
                @if (soloVer || esColaborador)
                {
                    <a class="nav-item-em @Activo("Deudas")" asp-controller="Deudas" asp-action="Index"><i class="bi bi-wallet2"></i><span>Deudas</span></a>
                }
                @if (!soloVer)
                {
                <a class="nav-item-em @Activo("Consultas")" asp-controller="Consultas" asp-action="Index"><i class="bi bi-chat-square-text"></i><span>Consultas rápidas</span></a>
                <a class="nav-item-em @Activo("Calculadora")" asp-controller="Calculadora" asp-action="Index"><i class="bi bi-calculator"></i><span>Calculadora</span></a>

                <span class="nav-grupo">Negocio</span>
                <a class="nav-item-em @Activo("Contrataciones")" asp-controller="Contrataciones" asp-action="Index"><i class="bi bi-journal-check"></i><span>Contrataciones</span></a>
                <a class="nav-item-em @Activo("Clientes")" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people"></i><span>Clientes</span></a>
                <a class="nav-item-em @Activo("Documentos")" asp-controller="Documentos" asp-action="Index"><i class="bi bi-file-earmark-pdf"></i><span>Documentos</span></a>
                <a class="nav-item-em @Activo("Integrantes")" asp-controller="Integrantes" asp-action="Index"><i class="bi bi-person-badge"></i><span>Integrantes</span></a>
                }
                @if (esAdmin)
                {
                    <a class="nav-item-em @Activo("Finanzas")" asp-controller="Finanzas" asp-action="Index"><i class="bi bi-cash-stack"></i><span>Finanzas</span></a>
                }

                @if (esAdmin)
                {
                    <span class="nav-grupo">Ajustes</span>
                    <a class="nav-item-em @Activo("Usuarios")" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-shield-lock"></i><span>Usuarios</span></a>
                    <a class="nav-item-em @Activo("Bitacora")" asp-controller="Bitacora" asp-action="Index"><i class="bi bi-journal-text"></i><span>Bitácora</span></a>
                    <a class="nav-item-em" asp-controller="Respaldo" asp-action="Descargar"><i class="bi bi-cloud-download"></i><span>Descargar respaldo</span></a>
                }
            </nav>

            <div class="sidebar-pie">
                <div class="usuario-chip">
                    <span class="avatar">@iniciales</span>
                    <span class="usuario-info">
                        <strong>@nombreUsuario</strong>
                        <small>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</small>
                    </span>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <a class="btn btn-sm btn-ghost flex-fill" asp-controller="Cuenta" asp-action="CambiarContrasena" title="Cambiar contraseña"><i class="bi bi-key"></i></a>
                    <form asp-controller="Cuenta" asp-action="Salir" method="post" class="flex-fill">
                        <button type="submit" class="btn btn-sm btn-ghost w-100" title="Cerrar sesión"><i class="bi bi-box-arrow-right"></i> Salir</button>
                    </form>
                </div>
            </div>
        </aside>
        <div class="sidebar-velo" id="sidebarVelo"></div>

        <div class="contenido">
            <header class="topbar">
                <button class="btn btn-icon d-lg-none" id="btnMenu" type="button" aria-label="Abrir menú"><i class="bi bi-list"></i></button>
                <div class="topbar-titulo">
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["Subtitulo"] != null)
                    {
                        <p>@ViewData["Subtitulo"]</p>
                    }
                </div>
                <div class="topbar-acciones">
                    <span class="fecha-hoy d-none d-md-inline"><i class="bi bi-calendar-event"></i> @hoyTexto</span>
                    @if (!soloVer)
                    {
                        <a class="btn btn-oro" asp-controller="Contrataciones" asp-action="Crear"><i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline"> Nueva contratación</span></a>
                    }
                </div>
            </header>

            <main class="pagina">
                @RenderBody()
            </main>
        </div>
    </div>


    <!-- Barra inferior (solo celular / tablet) -->
    <nav class="nav-inferior @(soloVer ? "nav-inferior-4" : "")" aria-label="Navegación rápida">
        <a class="@Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Inicio</span></a>
        <a class="@Activo("Agenda")" asp-controller="Agenda" asp-action="Index"><i class="bi bi-calendar3"></i><span>Agenda</span></a>
        @if (!soloVer)
        {
            <a class="nav-inferior-nueva" asp-controller="Contrataciones" asp-action="Crear" aria-label="Nueva contratación"><i class="bi bi-plus-lg"></i></a>
            <a class="@Activo("Contrataciones")" asp-controller="Contrataciones" asp-action="Index"><i class="bi bi-journal-check"></i><span>Eventos</span></a>
        }
        else
        {
            <a class="@Activo("Deudas")" asp-controller="Deudas" asp-action="Index"><i class="bi bi-wallet2"></i><span>Deudas</span></a>
        }
        <button type="button" id="btnMenuInferior"><i class="bi bi-list"></i><span>Menú</span></button>
    </nav>

    <!-- Avisos de éxito / error -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        @if (TempData["Exito"] is string exito)
        {
            <div class="toast toast-em exito" role="status" data-bs-delay="5000">
                <div class="toast-body"><i class="bi bi-check-circle-fill"></i> @exito</div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast toast-em error" role="alert" data-bs-delay="8000">
                <div class="toast-body"><i class="bi bi-exclamation-octagon-fill"></i> @error</div>
            </div>
        }
    </div>

    <partial name="_WhatsAppModal" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
